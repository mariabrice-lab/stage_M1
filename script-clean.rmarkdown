```

#### Isar spécifiques

```{r}
#fonction isarsp : affiche graphiquement l'isar
isarsp <- function(sp_name, isars){
  
  ##################################################
  #palette de couleur
  palette_sp <- setNames(
    RColorBrewer::brewer.pal(
      max(3, length(sp_name)),
      "Dark2"
    )[seq_along(sp_name)],
    sp_name
  )
  ##############################
  # ISAR
  tableau_final <- lapply(sp_name, function(sp){
    #vecteur T/F pour l'espece voulue
    is_sp <- isars$X$marks$PointType == sp
    #recuperation des neighborhoods pour l'espece voulue
    isar_sp <- apply(
      isars$neighborhoods[1, , is_sp, drop = FALSE],
      2,
      mean,
      na.rm = TRUE
    )
    #creation d'un tableau
    tibble(
      distance = as.numeric(names(isar_sp)),
      richesse = as.numeric(isar_sp),
      espece = sp
    )
  })
  #merge des tableau de chaque sp
  tableau_final <- dplyr::bind_rows(tableau_final)
  #creation du plot des isars
  plot_isar <- ggplot(
    tableau_final,
    aes(
      x = distance,
      y = richesse,
      color = espece
    )
  ) +
    geom_point() +
    geom_line() +
    scale_color_manual(values = palette_sp)
  
  #creation d'un objet
  nom_objet <- paste0(
    paste(sp_name, collapse = "_"),
    "_",
    deparse(substitute(isars))
  )
  
  assign(nom_objet, tableau_final, envir = .GlobalEnv)
  return(plot_isar)
}

#exemple
isarsp(c("Sextonia rubra","Ruizterania albiflora","Dicorynia guianensis"), rd_6)
```

Espece d'interet pour les populations :

- Fruit de coumou et jus/huile de Patawa : *Oenocarpus bacaba*, *Oenocarpus bataua*

- Feuilles de wai *Ruizterania albiflora*

- Grignon franc preleves pour son bois *Sextonia rubra*

- 75% du prelevement en bois *Sextonia rubra*, *Ruizterania albiflora*, *Dicorynia guianensis*

#### h0 : random location

On va comparer notre distribution avec une distribution "random location", tout les étiquettes (= individus) de la parcelles sont redistribués au hazard et on fait plusieurs simulations pour obtenir un intervalle de conf. *(le calcul peut prendre 30h...)*

```{r}
#Calcul de isars sous h0
#6
if (file.exists("data/rd_6_h0.Rdata")) {
  load("data/rd_6_h0.Rdata")
} else {
  rd_6_h0 <- accum_sp_hill(p2015_6_wmppp, 
                           # Richesse
                           orders = 0,
                           # Distances
                           r = seq(0, 30,2 ),
                           individual = TRUE,
                           h0 =  "random location",
                           n_simulations = 100,
                           richness_estimator = "iChao1"
  )
  save(rd_6_h0, file = "data/rd_6_h0.Rdata")
}


#15
if (file.exists("data/rd_15_h0.Rdata")) {
  load("data/rd_15_h0.Rdata")
} else {
  rd_15_h0 <- accum_sp_hill(p2015_15_wmppp, 
                           # Richesse
                           orders = 0,
                           # Distances
                           r = seq(0, 30,2 ),
                           h0 =  "random location",
                           individual = TRUE,
                           n_simulations = 100,
                           richness_estimator = "iChao1"
  )
  save(rd_15_h0, file = "data/rd_15_h0.Rdata")
}


#16
if (file.exists("data/rd_16_h0.Rdata")) {
  load("data/rd_16_h0.Rdata")
} else {
  rd_16_h0 <- accum_sp_hill(p2015_16_wmppp, 
                            # Richesse
                            orders = 0,
                            # Distances
                            r = seq(0, 30,2 ),
                            h0 =  "random location",
                            individual = TRUE,
