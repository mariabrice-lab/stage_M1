```{r}
library(spatstat.geom)

# =========================
# 1) DONNÉES
# =========================

X <- p2015_16_wmppp

# extraction des marques (espèces)
sp <- marks(X)$PointType


# matrice des distances inter-individus
d <- pairdist(X)

# =========================
# 2) FONCTION RICHESSE LOCALE
# =========================

richness_radius <- function(r) {
  apply(d <= r, 1, function(v) {
    length(unique(sp[v]))
  })
}

# =========================
# 3) COURBE D’ACCUMULATION SPATIALE
# =========================

r_vals <- seq(0, 30, 2)

richness_mean <- sapply(r_vals, function(r) {
  mean(richness_radius(r))
})

# =========================
# 4) TABLE DE RÉSULTATS
# =========================

result <- data.frame(
  radius = r_vals,
  richness = richness_mean
)

print(result)

# =========================
# 5) VÉRIFICATION À 30 m
# =========================

cat("Richesse moyenne à 30 m :", richness_mean[r_vals == 30], "\n")

# =========================
# 6) PLOT
# =========================

plot(r_vals, richness_mean,
     type = "l",
     lwd = 2,
     xlab = "Rayon (m)",
     ylab = "Richesse moyenne (nombre d'espèces)",
     main = "Accumulation spatiale (disque géométrique)")




# =========================
# fonction Simpson locale
# =========================

simpson_radius <- function(r) {
  apply(d <= r, 1, function(v) {
    
    species <- sp[v]
    tab <- table(species)
    p <- tab / sum(tab)
    
    # Simpson (Hill q=2 = 1 / sum(p^2))
    1 / sum(p^2)
  })
}

# =========================
# courbe
# =========================

r_vals <- seq(0, 30, 2)

simpson_mean <- sapply(r_vals, function(r) {
  mean(simpson_radius(r))
})

result_simpson <- data.frame(
  radius = r_vals,
  simpson = simpson_mean
)

print(result_simpson)

#olallallala
plot(r_vals, simpson_mean,
     type = "l",
     lwd = 2,
     xlab = "Rayon (m)",
     ylab = "Richesse moyenne (nombre d'espèces)",
     main = "Accumulation spatiale (simpson)")

```

