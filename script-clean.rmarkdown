  )
  save(rd_16_h0, file = "data/rd_16_h0.Rdata")
}


#On calcul avec simpsoon
if (file.exists("data/rd_16_h0_simpson.Rdata")) {
  load("data/rd_16_h0_simpson.Rdata")
} else {
  rd_16_h0_simpson <- accum_sp_hill(p2015_16_wmppp, 
