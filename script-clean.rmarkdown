fonction qui mets les itervalles de confiance sur les graph

```{r}

#fonction qui affiche intervalle de confiance h0 et isar spécifique
isarsp_ic <- function(sp_name, isars,isarsh0){
  
  ##################################################
  #palette de couleur
  palette_sp <- setNames(
    RColorBrewer::brewer.pal(
      max(3, length(sp_name)),
      "Dark2"
    )[seq_along(sp_name)],
    sp_name
  )
  ##############################
  # ISAR
  tableau_final <- lapply(sp_name, function(sp){
    #vecteur T/F pour l'espece voulue
    is_sp <- isars$X$marks$PointType == sp
    #recuperation des neighborhoods pour l'espece voulue
    isar_sp <- apply(
      isars$neighborhoods[1, , is_sp, drop = FALSE],
      2,
      mean,
      na.rm = TRUE
    )
    #creation d'un tableau
    tibble(
      distance = as.numeric(names(isar_sp)),
      richesse = as.numeric(isar_sp),
      espece = sp
    )
  })
  #merge des tableau de chaque sp
  tableau_final <- dplyr::bind_rows(tableau_final)
  
  #creation du plot des intervalles de conf
  plot_ic <- autoplot(isarsh0)
  
  plot_isar <- plot_ic +
    geom_point(
      aes(
        x = distance,
        y = richesse,
        color = espece
      ),
      data = tableau_final
    ) +
    geom_line(
      aes(
        x = distance,
        y = richesse,
        color = espece
      ),
      data = tableau_final,
      linewidth = 0.8
    ) +
    scale_color_manual(values = palette_sp)
  
  return(plot_isar)
}

#exemple (fig6)
isarsp_ic(c("Dicorynia guianensis","Eperua falcata","Chimarrhis turbinata","Lecythis persistens"), rd_16,rd_16_h0)


```

### Maps

```{r}
#fonction maps rend uniquement les arbres concernés
maps_localisation <- function(sp_name, data_wmppp){
  
  ##################################################
  #palette de couleur
  palette_sp <- setNames(
    RColorBrewer::brewer.pal(
      max(3, length(sp_name)),
      "Dark2"
    )[seq_along(sp_name)],
    sp_name)
  
  #####################################################
  # MAPS
  motif <- paste(sp_name, collapse = "|")
  
  selection <- stringr::str_detect(
    data_wmppp$marks$PointType,
    motif
  )
  
  plot_map <- autoplot(data_wmppp[selection, ]) +
    scale_color_manual(values = palette_sp) +
    theme_minimal(base_size = 13) +
    theme(plot.margin = margin(10, 10, 10, 10))
  return(plot_map)
}


#exemple
maps_localisation(c("Sextonia rubra","Ruizterania albiflora","Dicorynia guianensis"),p2015_16_wmppp)
```

autre fonction qui highlight les arbres mais en gardant tout les individus de la parcelle

*(ne conserve pas les weight)*

```{r}
#Highlight les arbres choisis
maps_sp <- function(sp_name, data_wmppp){
  
  library(spatstat.geom)
  library(stringr)
  library(ggplot2)
  library(RColorBrewer)
  
  
  marks <- data_wmppp$marks
  marks$PointType <- as.character(marks$PointType)
  
  motif <- paste(sp_name, collapse = "|")
  
  sel <- str_detect(marks$PointType, motif)
  
  palette_sp <- setNames(
    brewer.pal(max(3, length(sp_name)), "Dark2")[seq_along(sp_name)],
    sp_name
  )
  
  plot_map <- ggplot() +
    
    # couche 1 : tout les arbres en gris
    geom_point(
      data = as.data.frame(data_wmppp),
      aes(x, y),
      color = "honeydew2",
      size = 1.5
    ) +
    
    # couche 2 : les sp d'interet
    geom_point(
      data = as.data.frame(data_wmppp)[sel, ],
      aes(x, y, colour = marks$PointType[sel]),
      size = 2.5
    ) +
    
    scale_color_manual(
      values = palette_sp,
      name = "Espèces d'interêts"
      ) +
    theme_minimal(base_size = 13)
  
  
  return(plot_map)
}

maps_sp(c("Sextonia rubra","Ruizterania albiflora","Dicorynia guianensis"),p2015_6_wmppp)
```

# Analyse

[some species]{.underline}

- *Eperua falcata* (wapa) : espece qui semble etre bien espacée, \> 10m

- *Lecythis persistens* : \< vers 10m et \< vers 25m

- *Eschweilera sagotiana* : \> apres 20m

- *Pogonophora schomburgkiana* : dans la courbe globalement (petite aggregation)

- *Sandwithia guyanensis* : \>\> à partir de 15m

- *Oxandra asbeckii* : petit aggregats et attractive

*Dicorynia guyanensi*s (angéliques) : \> vers 10m plus legèrement au dessus, (mais je pense pas assez de pts pour faire de la donnée)

Especes de 60/40 indiv : plutot accum (*Licania canescens, Pradosia cochlearia* assez remarquable)

