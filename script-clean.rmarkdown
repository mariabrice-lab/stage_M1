### ISAR

#### calcul des isars collectifs

*Afin de selectionner des especes en particulier on calcul d'abords les isars de chaque sp, le calcul prend +/- 10min*

```{r}
#fonction
isars <- function(data, orders, r){
  accum_sp_hill(
    data, 
    # Richesse
    orders = orders,
    # Distances
    r = r,
    #calcul d'effet de bord
    richness_estimator = "iChao1",
    #??
    individual = TRUE
  )
}

#calcul de chaque plot
#6
if (file.exists("data/rd_6.Rdata")) {
  load("data/rd_6.Rdata")
}else{
  rd_6 <- isars(p2015_6_wmppp,0,seq(0, 30,2 ))
  save(rd_6, file = "data/rd_6.Rdata")}

#15
if (file.exists("data/rd_15.Rdata")) {
  load("data/rd_15.Rdata")
}else{
  rd_15 <- isars(p2015_15_wmppp,0,seq(0, 30,2 ))
  save(rd_15, file = "data/rd_15.Rdata")}

#16
#order = 0
if (file.exists("data/rd_16.Rdata")) {
