calcul des indices de diversité

```{r}
#calcul d'indices de div par plot et mise en tableau
indices_div <- Paracou2015 %>%
  split(.$Plot) %>%
  map_dfr(function(df){
    
    abd <- table(df$BinomialName)
    
    tibble(
      Plot = df$Plot[1],
      
      Shannon = ent_shannon(as.numeric(abd), estimator = "naive")[[3]],
      Simpson = ent_simpson(as.numeric(abd),estimator = "naive")[[3]],
      Hill_q1 = div_hill(as.numeric(abd), q = 1)[[3]],
      Hill_q2 = div_hill(as.numeric(abd), q = 2 )[[3]],
      
      Richesse = length(abd),
      Abondance = sum(abd)
    )
  })
indices_div

#selection des parcelles d'interet
indices_div <- indices_div[c(6,15,16), ]
indices_div

save(indices_div, file = "data/indices_div.csv")



indices_div
